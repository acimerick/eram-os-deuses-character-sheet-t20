<section class="eod-history">
    <header class="eod-section-heading eod-history-heading">
        <div>
            <span class="eod-section-kicker">MEMÓRIAS</span>
            <h2>HISTÓRICO</h2>
        </div>
    </header>

    <div class="eod-history-grid">
        <div class="eod-history-column eod-history-notes note-entries">
            <article class="eod-history-entry">
                <div class="eod-history-title section-titles">
                    <input type="text" name="system.detalhes.diario1.name" value="{{system.detalhes.diario1.name}}" placeholder="Pessoas Importantes">
                </div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.diario1.value">{{{system.detalhes.diario1.value}}}</div>
                </div>
            </article>

            <article class="eod-history-entry">
                <div class="eod-history-title section-titles">
                    <input type="text" name="system.detalhes.diario2.name" value="{{system.detalhes.diario2.name}}" placeholder="Locais Importantes">
                </div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.diario2.value">{{{system.detalhes.diario2.value}}}</div>
                </div>
            </article>

            <article class="eod-history-entry">
                <div class="eod-history-title section-titles">
                    <input type="text" name="system.detalhes.diario3.name" value="{{system.detalhes.diario3.name}}" placeholder="Missões">
                </div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.diario3.value">{{{system.detalhes.diario3.value}}}</div>
                </div>
            </article>

            <article class="eod-history-entry">
                <div class="eod-history-title section-titles">
                    <input type="text" name="system.detalhes.diario4.name" value="{{system.detalhes.diario4.name}}" placeholder="Diversos">
                </div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.diario4.value">{{{system.detalhes.diario4.value}}}</div>
                </div>
            </article>
        </div>

        <div class="eod-history-column eod-history-main note-entries">
            <article class="eod-history-entry eod-history-longform journal-notes">
                <div class="eod-history-title section-titles">Biografia</div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.biography.value">{{{system.detalhes.biography.value}}}</div>
                </div>
            </article>

            <article class="eod-history-entry eod-history-longform journal-notes">
                <div class="eod-history-title section-titles">Entrada de Diário</div>
                <div class="eod-history-editor editor">
                    <a class="editor-edit" title="Editar"><i class="fa-solid fa-pen-to-square"></i></a>
                    <div class="editor-content" data-engine="tinymce" data-collaborate="false" data-edit="system.detalhes.diario.value">{{{system.detalhes.diario.value}}}</div>
                </div>
            </article>
        </div>
    </div>
</section>
