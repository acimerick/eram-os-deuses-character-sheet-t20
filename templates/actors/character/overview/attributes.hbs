<section class="eod-attributes">
    <h2>ATRIBUTOS</h2>

    <div class="eod-attributes-compass">
        <div class="eod-compass-rose" aria-hidden="true">
            <img src="modules/eram-os-deuses-character-sheet-t20/assets/nautical/compass-rose.webp" alt="">
        </div>
        <div class="eod-compass-side eod-compass-side-left eod-compass-side-top" aria-hidden="true">MENTE<br>CONHECIMENTO<br>PRESENÇA</div>
