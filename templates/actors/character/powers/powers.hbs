<section class="eod-powers">
    <header class="eod-section-heading">
        <div>
            <span class="eod-section-kicker">APTIDÕES</span>
            <h2>PODERES</h2>
        </div>
    </header>

    <div class="eod-powers-content">
        {{#if eodPowerGroups.length}}
            {{#each eodPowerGroups as |group|}}
                <section class="eod-power-group" data-power-type="{{group.type}}">
                    <header class="eod-power-group-heading">
                        <h3>{{group.label}}</h3>
                        <span class="eod-power-group-count">{{group.items.length}}</span>
                    </header>

                    <ul class="item-list eod-power-list">
                        <li class="item item-header">
                            <div class="item-name">PODER</div>
                            <div class="item-type">SUBTIPO</div>
                            <div class="item-activation">ATIVAÇÃO</div>
                            <div class="item-controls">CONTROLES</div>
                        </li>

                        {{#each group.items as |item|}}
                            <li class="item" data-item-id="{{item._id}}">
                                <div class="item-name">
                                    <div class="item-image" style="background-image: url('{{item.img}}')"></div>
                                    <label>{{item.name}}</label>
                                </div>
                                <div class="item-type">
                                    {{#if item.system.subtipo}}
                                        {{item.system.subtipo}}
                                    {{else}}
                                        —
                                    {{/if}}
                                </div>
                                <div class="item-activation">
                                    {{eodPowerActivation item.system.ativacao.execucao}}
                                </div>
                                <div class="item-controls">
                                    <a class="item-control item-edit" data-action="editItem" title="Editar Poder">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a class="item-control item-delete" data-action="deleteItem" title="Excluir Poder">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </li>
                        {{/each}}
                    </ul>
                </section>
            {{/each}}
        {{else}}
            <div class="eod-powers-empty">
                <span>Nenhum poder ou habilidade registrado.</span>
            </div>
        {{/if}}

        <div class="eod-powers-create">
            <a class="item-control item-create" data-action="createItem" data-type="poder" title="Criar Poder">
                <i class="fas fa-plus"></i>
                <span>Adicionar Poder</span>
            </a>
        </div>
    </div>
</section>
